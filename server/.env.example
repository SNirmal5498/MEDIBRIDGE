# MediBridge Backend Environment Configuration Example
PORT=5000

# MongoDB Connection String (Atlas or Local MongoDB fallback)
MONGO_URI=mongodb://127.0.0.1:27017/medibridge

# JWT Secret Key
JWT_SECRET=medibridge_secret_key

# Optional External Translation Providers (Google Cloud, LibreTranslate)
# Default provider cascade: Google API -> LibreTranslate -> MyMemory -> Google Free Public Endpoint
TRANSLATION_PROVIDER=auto
GOOGLE_TRANSLATE_API_KEY=
LIBRETRANSLATE_API_URL=
LIBRETRANSLATE_API_KEY=

# Optional Razorpay Payment Gateway Keys (Test / Production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
